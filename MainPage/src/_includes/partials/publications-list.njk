<section class="section publications-grid-section">
  <div class="container">
    <div class="publications-grid">
      {% for pub in collections.publications | sortProjects %}
      <article class="publication-card">
        <div class="publication-card__media">
          {% set images = pub | publicationCardImages %}
          {% if images.length %}
          <a class="project-gallery__link publication-card__carousel" href="{{ images[0].original or images[0].image }}" data-project-lightbox aria-label="View publication image larger: {{ pub.title }}">
            {% for image in images %}
            <img src="{{ image.image }}"{% if image.srcset %} srcset="{{ image.srcset }}" sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 991px) calc((100vw - 64px) / 2), calc((100vw - 128px) / 3)" width="960" height="960"{% endif %} data-full-src="{{ image.original or image.image }}" alt="{{ pub.title }}" loading="lazy" class="publication-card__img{% if loop.first %} is-active{% endif %}"/>
            {% endfor %}
          </a>
          {% else %}
          <div class="publication-card__placeholder" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="publication-card__body">
          <h3 class="publication-card__title">{{ pub.title }}</h3>
          {% if pub.authors %}<p class="publication-card__authors">{{ pub.authors }}</p>{% endif %}
          {% if pub.venue %}<p class="publication-card__venue">{{ pub.venue }}</p>{% endif %}
          <div class="publication-card__links">
            {% if pub.pdf_url %}
            <a data-underline-link="" href="{{ pub.pdf_url }}" target="_blank" rel="noopener">PDF</a>
            {% endif %}
            {% if pub.bibtex_url %}
            <a data-underline-link="" href="{{ pub.bibtex_url }}" target="_blank" rel="noopener">BibTeX</a>
            {% elif pub.bibtex %}
            <details class="publication-card__bib">
              <summary data-underline-link="">BibTeX</summary>
              <pre class="publication-card__bibtex">{{ pub.bibtex }}</pre>
            </details>
            {% endif %}
            {% if pub.article_url %}
            <a data-underline-link="" href="{{ pub.article_url }}" target="_blank" rel="noopener">Article</a>
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
