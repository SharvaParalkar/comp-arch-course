{% macro memberCard(member) %}
<article class="team-card">
  <div class="team-card__media">
    {% if member.image %}
    <img src="{{ member.image }}" alt="{{ member.name or member.title }}" class="team-card__img" loading="lazy"/>
    {% else %}
    <div class="team-card__placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>
  {% if member.name %}<h2 class="team-card__name">{{ member.name }}</h2>{% endif %}
  {% if member.title %}<p class="team-card__title">{{ member.title }}</p>{% endif %}
  <div class="team-card__links">
    {% if member.website %}<a href="{{ member.website }}" target="_blank" rel="noopener noreferrer" aria-label="{{ member.name }} website" title="Website"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></a>{% endif %}
    {% if member.linkedin %}<a href="{{ member.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ member.name }} on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v10M5 5v.01M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"/></svg></a>{% endif %}
    {% if member.instagram %}<a href="{{ member.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="{{ member.name }} on Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></a>{% endif %}
  </div>
</article>
{% endmacro %}

<section class="section team-grid-section">
  <div class="container">
    {% if entry.team_groups and entry.team_groups.length %}
      {% for group in entry.team_groups %}
      <section class="team-group">
        {% if group.title %}<h2 class="team-group__title">{{ group.title }}</h2>{% endif %}
        <div class="team-grid">
          {% for member in group.members %}{{ memberCard(member) }}{% endfor %}
        </div>
      </section>
      {% endfor %}
    {% elif entry.team_members and entry.team_members.length %}
    <div class="team-grid">
      {% for member in entry.team_members %}{{ memberCard(member) }}{% endfor %}
    </div>
    {% else %}
    <div class="team-grid">
      <article class="team-card">
        <div class="team-card__media"><img src="/uploads/media/about-portrait.jpg" alt="Mostafa Akbari" class="team-card__img" loading="lazy"/></div>
        <h2 class="team-card__name">Mostafa Akbari</h2>
        <p class="team-card__title">PI</p>
        <div class="team-card__links">
          <a href="https://mostafaakbari.net" target="_blank" rel="noopener noreferrer" aria-label="Mostafa Akbari website" title="Website"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 18"/></svg></a>
          <a href="https://www.linkedin.com/in/mostafaakbari/" target="_blank" rel="noopener noreferrer" aria-label="Mostafa Akbari on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v10M5 5v.01M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"/></svg></a>
          <a href="https://www.instagram.com/akbariae/" target="_blank" rel="noopener noreferrer" aria-label="Mostafa Akbari on Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></a>
        </div>
      </article>
      {% for placeholder in [1, 2] %}
      <article class="team-card team-card--placeholder" aria-label="Team member profile placeholder">
        <div class="team-card__media"><div class="team-card__placeholder" aria-hidden="true"></div></div>
        <h2 class="team-card__name">Team member</h2>
        <p class="team-card__title">Name and title</p>
        <div class="team-card__links" aria-label="Website, LinkedIn, and Instagram links"><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg></span><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 9v10M5 5v.01M10 19v-6a4 4 0 0 1 8 0v6M10 10v9"/></svg></span><span aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></span></div>
      </article>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
