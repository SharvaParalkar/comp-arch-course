<script>
document.addEventListener("DOMContentLoaded", function() {
  const videos = document.querySelectorAll('video:not([data-home-hero])');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target;
      if (entry.isIntersecting) {
        requestAnimationFrame(() => {
          setTimeout(() => {
            if (video.paused) video.play().catch(() => {});
          }, 150);
        });
      } else if (!video.paused) {
        video.pause();
      }
    });
  }, { threshold: 0.05 });
  videos.forEach(video => observer.observe(video));
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function() {
  const hero = document.querySelector("[data-home-hero-video]");
  if (!hero) return;

  const lq = hero.querySelector('[data-home-hero="lq"]');
  const hq = hero.querySelector('[data-home-hero="hq"]');
  const ultra = hero.querySelector('[data-home-hero="ultra"]');
  if (!lq && !hq && !ultra) return;

  const unlock = (video) => {
    if (!video) return;
    video.muted = true;
    video.defaultMuted = true;
    video.volume = 0;
    video.setAttribute("muted", "");
    video.playsInline = true;
    video.setAttribute("playsinline", "");
    video.setAttribute("webkit-playsinline", "");
    video.setAttribute("x5-playsinline", "");
  };

  const playSafe = (video) => {
    if (!video) return Promise.resolve(false);
    unlock(video);
    try {
      const result = video.play();
      if (result && typeof result.then === "function") {
        return result.then(() => true).catch(() => false);
      }
      return Promise.resolve(!video.paused);
    } catch (_) {
      return Promise.resolve(false);
    }
  };

  const activeVideo = () => {
    if (ultra && ultra.classList.contains("is-ready")) return ultra;
    if (hq && hq.classList.contains("is-ready")) return hq;
    return lq;
  };

  const canLoadUltra = () => {
    const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    if (!conn) return true;
    if (conn.saveData) return false;
    const type = conn.effectiveType;
    if (type === "slow-2g" || type === "2g" || type === "3g") return false;
    if (typeof conn.downlink === "number" && conn.downlink > 0 && conn.downlink < 2.5) return false;
    return true;
  };

  const upgradeVideo = (fromVideo, toVideo, { onReady } = {}) => {
    const src = toVideo.getAttribute("data-upgrade-src");
    if (!src) return;
    let swapped = false;
    const swap = () => {
      if (swapped) return;
      if (toVideo.readyState < 2) return;
      swapped = true;
      if (fromVideo && Number.isFinite(fromVideo.currentTime)) {
        try { toVideo.currentTime = fromVideo.currentTime; } catch (_) {}
      }
      playSafe(toVideo).then((ok) => {
        if (!ok) {
          swapped = false;
          window.setTimeout(swap, 400);
          return;
        }
        toVideo.classList.add("is-ready");
        window.setTimeout(() => {
          if (!fromVideo) return;
          fromVideo.pause();
          fromVideo.removeAttribute("src");
          try { fromVideo.load(); } catch (_) {}
        }, 550);
        if (onReady) onReady();
      });
    };
    unlock(toVideo);
    toVideo.src = src;
    toVideo.preload = "auto";
    try { toVideo.load(); } catch (_) {}
    ["loadeddata", "canplay", "canplaythrough"].forEach((evt) => {
      toVideo.addEventListener(evt, swap, { passive: true });
    });
  };

  // Keep trying until the hero is actually playing (iOS often rejects the first play()).
  let playAttempts = 0;
  const ensurePlaying = () => {
    const video = activeVideo();
    if (!video) return;
    if (!video.paused && !video.ended) return;
    playAttempts += 1;
    playSafe(video);
    if (playAttempts < 12) {
      window.setTimeout(ensurePlaying, 250 * Math.min(playAttempts, 4));
    }
  };

  unlock(lq);
  unlock(hq);
  unlock(ultra);

  if (lq) {
    ["loadedmetadata", "loadeddata", "canplay", "canplaythrough", "playing"].forEach((evt) => {
      lq.addEventListener(evt, () => playSafe(lq), { passive: true });
    });
    // Force a load + play cycle; needed on some iOS versions.
    try { lq.load(); } catch (_) {}
    playSafe(lq);
  }

  ensurePlaying();

  const gestureEvents = ["touchstart", "touchend", "pointerdown", "click", "scroll", "pageshow"];
  const onGesture = () => {
    ensurePlaying();
    const video = activeVideo();
    if (video && !video.paused) {
      gestureEvents.forEach((evt) => window.removeEventListener(evt, onGesture));
    }
  };
  gestureEvents.forEach((evt) => window.addEventListener(evt, onGesture, { passive: true }));
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") ensurePlaying();
  });

  if (hq) {
    upgradeVideo(lq, hq, {
      onReady: () => {
        if (ultra && canLoadUltra()) upgradeVideo(hq, ultra);
      }
    });
  }

  const heroObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = activeVideo();
      if (!video) return;
      if (entry.intersectionRatio > 0.2) playSafe(video);
      else if (entry.intersectionRatio === 0) video.pause();
    });
  }, { threshold: [0, 0.2, 0.5, 1] });
  heroObserver.observe(hero);
});
</script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/SplitText.min.js"></script>
<script>
gsap.registerPlugin(ScrollTrigger, SplitText);
function initHighlightText() {
  document.querySelectorAll("[data-highlight-text]").forEach((heading) => {
    const scrollStart = heading.getAttribute("data-highlight-scroll-start") || "top 75%";
    const scrollEnd = heading.getAttribute("data-highlight-scroll-end") || "center 25%";
    const fadedValue = heading.getAttribute("data-highlight-fade") || 0.00;
    const staggerValue = heading.getAttribute("data-highlight-stagger") || 0.1;
    new SplitText(heading, {
      type: "words, chars", autoSplit: true,
      onSplit(self) {
        let ctx = gsap.context(() => {
          gsap.timeline({
            scrollTrigger: { scrub: true, trigger: heading, start: scrollStart, end: scrollEnd }
          }).from(self.chars, { autoAlpha: fadedValue, stagger: staggerValue, ease: "linear" });
        });
        return ctx;
      }
    });
  });
}
document.addEventListener("DOMContentLoaded", () => initHighlightText());
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-video="track"]').forEach((track) => {
    const video = track.querySelector('[data-video="video"]');
    if (!video) return;
    video.load();
    const proxy = { currentTime: 0 };
    video.addEventListener('loadedmetadata', function() {
      gsap.timeline({
        scrollTrigger: {
          trigger: track, start: "top 170%", end: "bottom center", scrub: 0.5,
          onUpdate: (self) => {
            const targetTime = self.progress * video.duration;
            gsap.to(proxy, {
              currentTime: targetTime, duration: 0.1, ease: "power4.out",
              onUpdate: () => { if (video.readyState) video.currentTime = proxy.currentTime; }
            });
          }
        }
      });
    });
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const galleries = document.querySelectorAll("[data-proj-gallery]");
  if (!galleries.length) return;

  const INTERVAL_MS = 2600;

  galleries.forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll(".proj-row__img"));
    if (slides.length < 2) return;

    let index = slides.findIndex((slide) => slide.classList.contains("is-active"));
    if (index < 0) index = 0;
    let timer = null;
    let paused = false;
    let visible = false;

    const show = (next) => {
      slides[index].classList.remove("is-active");
      slides[index].setAttribute("aria-hidden", "true");
      index = next;
      slides[index].classList.add("is-active");
      slides[index].removeAttribute("aria-hidden");
    };

    const tick = () => show((index + 1) % slides.length);

    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      if (paused || !visible || document.hidden || timer) return;
      timer = setInterval(tick, INTERVAL_MS);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) start();
          else stop();
        });
      },
      { threshold: 0.35 }
    );
    io.observe(gallery);

    gallery.addEventListener("mouseenter", () => {
      paused = true;
      stop();
    });
    gallery.addEventListener("mouseleave", () => {
      paused = false;
      start();
    });
    gallery.addEventListener("focusin", () => {
      paused = true;
      stop();
    });
    gallery.addEventListener("focusout", () => {
      paused = false;
      start();
    });
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const grids = Array.from(document.querySelectorAll("[data-fit-gallery]"));
  if (!grids.length) return;

  const desktop = window.matchMedia("(min-width: 992px)");
  const macro = 12;

  const resetItem = (item) => {
    item.style.gridColumn = "";
    item.style.gridRow = "";
  };

  const layout = (grid) => {
    const split = grid.closest(".detail-split__grid");
    const copy = split && split.querySelector(".detail-split__copy");
    const items = Array.from(grid.querySelectorAll(".fit-gallery__item"));
    const count = items.length;
    if (!copy || !count) return;

    if (!desktop.matches) {
      grid.classList.remove("is-fitted");
      grid.style.height = "";
      grid.style.gridTemplateColumns = "";
      grid.style.gridTemplateRows = "";
      if (split) split.style.gridTemplateColumns = "";
      items.forEach(resetItem);
      delete grid.dataset.fitKey;
      return;
    }

    const shell = split.parentElement;
    const shellStyles = shell ? getComputedStyle(shell) : null;
    const shellPad = shellStyles
      ? (parseFloat(shellStyles.paddingLeft) || 0) + (parseFloat(shellStyles.paddingRight) || 0)
      : 0;
    const columnGap = parseFloat(getComputedStyle(split).columnGap) || 0;
    const inner = Math.max(0, (shell ? shell.clientWidth : split.clientWidth) - shellPad - columnGap);
    const left = Math.round(inner * 0.425);
    if (inner > 80) {
      split.style.gridTemplateColumns = `${left}px minmax(0, 1fr)`;
    }

    const height = Math.round((() => {
      const kids = Array.from(copy.children).filter((child) => child.getClientRects().length);
      if (!kids.length) return copy.getBoundingClientRect().height;
      const top = kids[0].getBoundingClientRect().top;
      const bottom = kids[kids.length - 1].getBoundingClientRect().bottom;
      const style = getComputedStyle(copy);
      return bottom - top + (parseFloat(style.paddingTop) || 0) + (parseFloat(style.paddingBottom) || 0);
    })());
    const width = Math.round(grid.clientWidth);
    if (height < 40 || width < 40) return;

    const gap = parseFloat(getComputedStyle(grid).columnGap) || 0;
    const choices = [1, 2, 3, 4].filter((cols) => cols <= count);
    let cols = choices[0] || 1;
    let best = Infinity;

    choices.forEach((choice) => {
      const rows = Math.ceil(count / choice);
      const cellW = (width - gap * (choice - 1)) / choice;
      const cellH = (height - gap * (rows - 1)) / rows;
      if (cellW <= 1 || cellH <= 1) return;
      const aspect = cellW / cellH;
      let score = Math.abs(Math.log(aspect / 1.2));
      const remainder = count % choice;
      if (remainder !== 0) score += 0.12;
      if (remainder === 1 && choice > 1) score += 0.45;
      if (cellH < 64) score += (64 - cellH) / 64;
      if (score < best) {
        best = score;
        cols = choice;
      }
    });

    const rows = Math.ceil(count / cols);
    const key = [height, width, cols, count].join(":");
    if (grid.dataset.fitKey === key) return;
    grid.dataset.fitKey = key;
    grid.classList.add("is-fitted");
    grid.style.height = height + "px";
    grid.style.gridTemplateColumns = `repeat(${macro}, minmax(0, 1fr))`;
    grid.style.gridTemplateRows = `repeat(${rows}, minmax(0, 1fr))`;

    items.forEach((item, index) => {
      const row = Math.floor(index / cols);
      const indexInRow = index % cols;
      const countInRow = row === rows - 1 ? count - row * cols : cols;
      const span = macro / countInRow;
      const start = indexInRow * span + 1;
      item.style.gridColumn = `${start} / span ${span}`;
      item.style.gridRow = String(row + 1);
    });
  };

  const layoutAll = () => grids.forEach(layout);
  const observer = new ResizeObserver(layoutAll);
  grids.forEach((grid) => {
    const copy = grid.closest(".detail-split__grid")?.querySelector(".detail-split__copy");
    if (copy) observer.observe(copy);
    observer.observe(grid.parentElement || grid);
  });

  if (typeof desktop.addEventListener === "function") {
    desktop.addEventListener("change", layoutAll);
  } else if (typeof desktop.addListener === "function") {
    desktop.addListener(layoutAll);
  }

  window.addEventListener("load", layoutAll);
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(layoutAll);
    document.fonts.addEventListener("loadingdone", layoutAll);
  }
  grids.forEach((grid) => {
    grid.querySelectorAll("img").forEach((img) => {
      if (!img.complete) img.addEventListener("load", layoutAll, { once: true });
    });
  });
  [200, 800, 1600].forEach((delay) => window.setTimeout(layoutAll, delay));
  layoutAll();
});
</script>
