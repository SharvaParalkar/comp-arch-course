<script>
(function () {
  const root = document.documentElement;
  const setAppHeight = () => {
    const height = Math.round(
      (window.visualViewport && window.visualViewport.height) || window.innerHeight || root.clientHeight
    );
    if (!height) return;
    root.style.setProperty("--app-height", height + "px");
    document.querySelectorAll(".home-masthead").forEach((el) => {
      el.style.setProperty("--home-masthead-height", height + "px");
    });
  };

  setAppHeight();
  window.addEventListener("resize", setAppHeight, { passive: true });
  window.addEventListener("orientationchange", () => {
    window.setTimeout(setAppHeight, 150);
  }, { passive: true });
  if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", setAppHeight, { passive: true });
  }
  document.addEventListener("DOMContentLoaded", setAppHeight);
})();
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
