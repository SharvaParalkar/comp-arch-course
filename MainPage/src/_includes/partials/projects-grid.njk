<section class="section projects-list-section">
  <div class="container">
    <div class="projects-list">
      {% for project in collections.projects | sortProjects %}
      {% set href = project.permalink | hrefPath %}
      {% set images = project | projectCardImages %}
      <article class="proj-row">
        <a class="proj-row__media{% if images.length > 1 %} is-gallery{% endif %}" href="{{ href }}"{% if images.length > 1 %} data-proj-gallery{% endif %}>
          {% if images.length %}
            {% for img in images %}
            <img
              src="{{ img.image }}"
              alt="{{ img.alt or project.title }}"
              class="proj-row__img{% if loop.first %} is-active{% endif %}"
              loading="{{ 'eager' if loop.first else 'lazy' }}"
              {% if not loop.first %}aria-hidden="true"{% endif %}
            />
            {% endfor %}
          {% else %}
            <div class="proj-row__placeholder" aria-hidden="true"></div>
          {% endif %}
        </a>
        <div class="proj-row__body">
          <h3 class="proj-row__title"><a href="{{ href }}">{{ project.title }}</a></h3>
          {% if project.summary %}<p class="proj-row__summary">{{ project.summary }}</p>{% endif %}
          {% if project.year %}<p class="proj-row__year">{{ project.year }}{% if project.category %} · {{ project.category }}{% endif %}</p>{% elif project.category %}<p class="proj-row__year">{{ project.category }}</p>{% endif %}
          <div class="proj-row__links">
            <a data-underline-link="" href="{{ href }}">View project</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
