<section class="section projects-grid-section">
  <div class="container">
    <div class="projects-grid">
      {% for project in collections.projects | sortProjects %}
      {% set href = project.permalink | hrefPath %}
      <article class="project-card">
        <div class="project-card__media">
          {% if project.cover_image %}
          {% set images = project | projectCardImages %}
          <a class="project-gallery__link project-card__carousel" href="{{ href }}" aria-label="View project: {{ project.title }}">
            {% for image in images %}
            <img src="{{ image.image }}" alt="{{ image.alt }}" loading="lazy" class="project-card__img{% if loop.first %} is-active{% endif %}"/>
            {% endfor %}
          </a>
          {% else %}
          <div class="project-card__placeholder" aria-hidden="true"></div>
          {% endif %}
        </div>
        {% if project.year %}<div class="project-card__year">{{ project.year }}</div>{% endif %}
        <h3 class="project-card__title">
          <a href="{{ href }}">{{ project.title }}</a>
        </h3>
        {% if project.summary %}
        <p class="project-card__summary">{{ project.summary }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
