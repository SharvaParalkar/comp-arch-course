<section class="section projects-grid-section">
  <div class="container">
    <div class="projects-grid teaching-grid">
      {% for item in collections.teaching | sortProjects %}
      {% set href = item.permalink | hrefPath %}
      {% set images = item | teachingCardImages %}
      <article class="project-card">
        <a class="project-card__media teaching-card__carousel" href="{{ href }}" aria-label="View teaching page: {{ item.card_title or item.title }}">
          {% if images.length %}
          {% for image in images %}
          <img src="{{ image.image }}" alt="{{ image.alt }}" loading="lazy" class="project-card__img teaching-card__img{% if loop.first %} is-active{% endif %}"/>
          {% endfor %}
          {% else %}
          <div class="project-card__placeholder" aria-hidden="true"></div>
          {% endif %}
        </a>
        {% if item.year %}<div class="project-card__year">{{ item.year }}</div>{% endif %}
        <h3 class="project-card__title">
          <a href="{{ href }}">{{ item.card_title or item.title }}</a>
        </h3>
        {% if item.instructors %}
        <p class="project-card__instructors"><strong>Instructors:</strong> {{ item.instructors }}</p>
        {% endif %}
        {% if item.summary %}
        <p class="project-card__summary">{{ item.summary }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
