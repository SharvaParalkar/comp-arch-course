{% set detail_authors = entry | detailAuthors %}
{% set gallery_items = entry | galleryItems %}
<section class="section detail-split">
  <div class="container">
    <div class="detail-split__grid">
      <div class="detail-split__copy">
        <header class="detail-header">
          {% if entry.year or entry.category %}
          <div class="h-x-small detail-header__meta">
            {% if entry.year %}{{ entry.year }}{% endif %}{% if entry.year and entry.category %} · {% endif %}{% if entry.category %}{{ entry.category }}{% endif %}
          </div>
          {% endif %}
          <h1 class="h-x-large detail-header__title">{{ entry.title }}</h1>
          {% if detail_authors %}<p class="detail-header__authors">{{ detail_authors }}</p>{% endif %}
        </header>
        {% set section_filter = "copy" %}
        {% include "sections/render.njk" %}
      </div>
      <div class="detail-split__gallery">
        {% if gallery_items.length %}
        <div class="fit-gallery{% if gallery_items.length == 1 %} is-single{% endif %}">
          {% for item in gallery_items %}
          <figure class="fit-gallery__item">
            {% if item.kind == "video" %}
            <video src="{{ item.src }}" muted loop playsinline preload="metadata" aria-label="{{ item.alt }}"></video>
            {% else %}
            <a class="project-gallery__link" href="{{ item.src }}" data-project-lightbox aria-label="View image larger: {{ item.alt or entry.title }}">
              <img src="{{ item.src }}" alt="{{ item.alt }}" loading="lazy"/>
            </a>
            {% endif %}
          </figure>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
    <dialog class="project-lightbox" aria-label="Expanded project image">
      <button class="project-lightbox__close" type="button" aria-label="Close image">×</button>
      <button class="project-lightbox__nav project-lightbox__nav--previous" type="button" aria-label="Previous image">‹</button>
      <img class="project-lightbox__image" alt=""/>
      <button class="project-lightbox__nav project-lightbox__nav--next" type="button" aria-label="Next image">›</button>
      <p class="project-lightbox__caption" aria-live="polite"></p>
    </dialog>
  </div>
</section>
