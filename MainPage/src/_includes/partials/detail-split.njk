{% set detail_authors = entry | detailAuthors %}
{% set gallery_items = entry | galleryItems %}
<section class="section detail-split">
  <div class="container">
    <div class="detail-split__grid">
      <div class="detail-split__copy">
        <header class="detail-header">
          {% if entry.year or entry.category %}
          <div class="h-x-small detail-header__meta">
            {% if entry.year %}{{ entry.year }}{% endif %}{% if entry.year and entry.category %} · {% endif %}{% if entry.category %}{{ entry.category }}{% endif %}
          </div>
          {% endif %}
          <h1 class="h-x-large detail-header__title">{{ entry.title }}</h1>
          {% if detail_authors %}<p class="detail-header__authors">{{ detail_authors }}</p>{% endif %}
        </header>
        {% set section_filter = "copy" %}
        {% include "sections/render.njk" %}
      </div>
      <div class="detail-split__gallery">
        {% if gallery_items.length %}
        <div class="fit-gallery{% if gallery_items.length == 1 %} is-single{% endif %}" data-fit-gallery>
          {% for item in gallery_items %}
          <figure class="fit-gallery__item">
            {% if item.kind == "video" %}
            <video src="{{ item.src }}" muted loop playsinline preload="metadata" aria-label="{{ item.alt }}"></video>
            {% else %}
            <img src="{{ item.src }}" alt="{{ item.alt }}" loading="lazy"/>
            {% endif %}
          </figure>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
