<dialog class="project-lightbox" aria-label="Expanded image gallery">
  <button class="project-lightbox__close" type="button" aria-label="Close image">×</button>
  <button class="project-lightbox__nav project-lightbox__nav--previous" type="button" aria-label="Previous image">‹</button>
  <img class="project-lightbox__image" alt=""/>
  <button class="project-lightbox__nav project-lightbox__nav--next" type="button" aria-label="Next image">›</button>
</dialog>
