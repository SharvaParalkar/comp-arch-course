{% for section in entry.sections %}
  {% if section.type == 'headline' %}
  <section class="section page-block"><div class="container">
    <h1 class="page-title">{{ section.text }}</h1>
  </div></section>
  {% elif section.type == 'two_column' %}
  <section class="section page-block"><div class="container">
    {% if section.heading %}<h2 class="page-subtitle">{{ section.heading }}</h2>{% endif %}
    <div class="split-text">
      <div class="prose">{{ section.left | safe }}</div>
      <div class="prose">{{ section.right | safe }}</div>
    </div>
  </div></section>
  {% elif section.type == 'hero_video' %}
  <header class="section page-block"><div class="container">
    {% if section.title %}<h1 class="page-title">{{ section.title }}</h1>{% endif %}
    <div class="detail-media">
      <video loading="eager" preload="metadata" loop playsinline muted autoplay class="detail-media__asset">
        <source src="{{ section.video_url }}" type="video/mp4"/>
      </video>
    </div>
  </div></header>
  {% elif section.type == 'hero_image' %}
  <header class="section page-block"><div class="container">
    {% if section.title %}<h1 class="page-title">{{ section.title }}</h1>{% endif %}
    {% if section.subtitle %}<p class="page-kicker">{{ section.subtitle }}</p>{% endif %}
    <div class="detail-media">
      <img src="{{ section.image }}" alt="{{ section.alt or section.title or '' }}" class="detail-media__asset"/>
    </div>
    {% if section.cta_url %}
    <p class="page-cta"><a data-underline-link="" href="{{ section.cta_url }}">{{ section.cta_label or "Learn more" }}</a></p>
    {% endif %}
  </div></header>
  {% elif section.type == 'video' %}
  <section class="section page-block"><div class="container">
    <div class="detail-media">
      <video loading="lazy" preload="metadata" loop playsinline muted autoplay class="detail-media__asset">
        <source src="{{ section.video_url }}" type="video/mp4"/>
      </video>
    </div>
    {% if section.caption %}<p class="detail-caption">{{ section.caption }}</p>{% endif %}
  </div></section>
  {% elif section.type == 'image' %}
  <section class="section page-block"><div class="container">
    <div class="detail-media">
      <img src="{{ section.image }}" loading="lazy" alt="{{ section.alt or '' }}" class="detail-media__asset"/>
    </div>
    {% if section.caption %}<p class="detail-caption">{{ section.caption }}</p>{% endif %}
  </div></section>
  {% elif section.type == 'image_text' %}
  <section class="section page-block"><div class="container">
    <div class="image-text{% if section.image_position == 'left' %} is-image-left{% endif %}">
      <div class="image-text__body prose">{{ section.body | safe }}</div>
      {% if section.image %}
      <div class="image-text__media">
        <img src="{{ section.image }}" alt="{{ section.alt or '' }}" class="image-text__img"/>
      </div>
      {% endif %}
    </div>
  </div></section>
  {% elif section.type == 'image_gallery' and section.images %}
  <section class="section page-block"><div class="container"><div class="image-gallery">
    {% for item in section.images %}
    <figure class="image-gallery__item">
      <img src="{{ item.image }}" loading="lazy" alt="{{ item.alt or '' }}" class="image-gallery__img"/>
      {% if item.caption %}<figcaption class="image-gallery__caption">{{ item.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div></div></section>
  {% elif section.type == 'stat' %}
  <section class="section page-block"><div class="container">
    <p class="page-kicker">{{ section.label }}</p>
    <p class="page-title">{{ section.value }}</p>
  </div></section>
  {% elif section.type == 'rich_text' %}
  <section class="section page-block"><div class="container">
    <div class="prose">{{ section.body | safe }}</div>
  </div></section>
  {% endif %}
{% endfor %}
