{% set _sections = entry.sections | detailSections(entry, show_detail_header) %}
{% if section_filter == "media" %}
  {% set _sections = _sections | detailMedia %}
{% elif section_filter == "copy" %}
  {% set _sections = _sections | detailCopy %}
{% endif %}
{% for section in _sections %}
  {% if section.type == 'home_masthead' %}
  <header class="section home-masthead"{% if section.video_lq_url or section.video_lq_mp4_url or section.video_hq_url %} data-home-hero-video{% endif %}>
    {% if section.video_lq_url or section.video_lq_mp4_url or section.video_hq_url %}
    <div class="home-masthead__media" aria-hidden="true">
      {% if section.video_lq_mp4_url or section.video_lq_url %}
      {# iOS Safari autoplay is most reliable with a direct MP4 src (not <source> children) #}
      <video
        class="home-masthead__video home-masthead__video--lq"
        data-home-hero="lq"
        {% if section.video_lq_mp4_url %}src="{{ section.video_lq_mp4_url }}"{% elif section.video_lq_url %}src="{{ section.video_lq_url }}"{% endif %}
        muted
        autoplay
        loop
        playsinline
        webkit-playsinline
        x5-playsinline
        preload="auto"
      ></video>
      {% endif %}
      {% if section.video_hq_url %}
      <video
        class="home-masthead__video home-masthead__video--hq"
        data-home-hero="hq"
        data-hq-src="{{ section.video_hq_url }}"
        muted
        loop
        playsinline
        webkit-playsinline
        x5-playsinline
        preload="auto"
      ></video>
      {% endif %}
    </div>
    {% endif %}
    <div class="home-masthead__readable" aria-hidden="true"></div>
    <div class="container">
      <div class="home-masthead__stack">
        <h1 class="display-h home-masthead__title">{% if section.title_line_1 %}{{ section.title_line_1 }}{% if section.title_line_2 %}<br/>{{ section.title_line_2 }}{% endif %}{% else %}{{ section.title }}{% endif %}</h1>
        {% if section.subtitle %}<div class="h-x-small home-masthead__tagline">{{ section.subtitle }}</div>{% endif %}
      </div>
    </div>
  </header>
  {% elif section.type == 'headline' %}
  <section class="section is-t-double"><div class="container"><div class="d"><div class="h-x-large">{{ section.text }}</div></div></div></section>
  {% elif section.type == 'two_column' %}
  <section class="section"><div class="container">
    {% if section.heading %}<div class="d"><div class="h-medium-div"><h2 class="h-medium">{{ section.heading }}</h2></div></div>{% endif %}
    <div class="d">
      <div class="d is-tab-half"><div class="txt-large w-richtext">{{ section.left | safe }}</div></div>
      <div class="d is-tab-half"><div class="txt-large w-richtext">{{ section.right | safe }}</div></div>
    </div>
  </div></section>
  {% elif section.type == 'hero_video' %}
  <header class="section is-hero"><div class="bg-video-wrap"><div class="video-aspect-box">
    <video loading="eager" preload="metadata" loop playsinline muted autoplay class="video-element">
      <source src="{{ section.video_url }}" type="video/mp4"/>
    </video>
  </div></div><div class="container is-hero-100 is-exclusion"><div class="d"><h1 class="display-h">{{ section.title }}</h1></div></div></header>
  {% elif section.type == 'hero_image' %}
  <header class="section is-hero">
    <div class="bg-video-wrap"><div class="video-aspect-box">
      <img src="{{ section.image }}" alt="{{ section.alt or section.title or '' }}" class="video-element hero-still"/>
    </div></div>
    <div class="container is-hero-100 is-exclusion"><div class="d">
      {% if section.title %}<h1 class="display-h">{{ section.title }}</h1>{% endif %}
      {% if section.subtitle %}<div class="h-x-small hero-still__subtitle">{{ section.subtitle }}</div>{% endif %}
    </div></div>
  </header>
  {% elif section.type == 'video' %}
  <section class="section page-media-section"><div class="container">
    <figure class="page-media">
      <video loading="lazy" preload="metadata" loop playsinline muted autoplay controls>
        <source src="{{ section.video_url }}" type="video/mp4"/>
      </video>
      {% if section.caption %}<figcaption class="page-media__caption h-x-small">{{ section.caption }}</figcaption>{% endif %}
    </figure>
  </div></section>
  {% elif section.type == 'image' %}
  <section class="section page-media-section"><div class="container">
    <figure class="page-media">
      <img src="{{ section.image }}" loading="lazy" alt="{{ section.alt or '' }}"/>
      {% if section.caption %}<figcaption class="page-media__caption h-x-small">{{ section.caption }}</figcaption>{% endif %}
    </figure>
  </div></section>
  {% elif section.type == 'image_text' %}
  <section class="section"><div class="container">
    <div class="image-text{% if section.image_position == 'left' %} is-image-left{% endif %}">
      <div class="image-text__body txt-large w-richtext">{{ section.body | safe }}</div>
      {% if section.image %}
      <div class="image-text__media">
        <img src="{{ section.image }}" alt="{{ section.alt or '' }}" class="image-text__img"/>
      </div>
      {% endif %}
    </div>
  </div></section>
  {% elif section.type == 'image_gallery' and section.images %}
  <section class="section image-gallery-section"><div class="container"><div class="image-gallery">
    {% for item in section.images %}
    <figure class="image-gallery__item">
      <img src="{{ item.image }}" loading="lazy" alt="{{ item.alt or '' }}" class="image-gallery__img"/>
      {% if item.caption %}<figcaption class="image-gallery__caption">{{ item.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div></div></section>
  {% elif section.type == 'stat' %}
  <section class="section"><div class="container"><div class="d"><div class="vert-div">
    <div class="display-eyebrow-div"><div class="h-x-small">{{ section.label }}</div></div>
    <div class="display-h is-data">{{ section.value }}</div>
  </div></div></div></section>
  {% elif section.type == 'rich_text' %}
  <section class="section{% if show_detail_header %} detail-prose{% endif %}"><div class="container"><div class="d"><div class="txt-large w-richtext">{{ section.body | safe }}</div></div></div></section>
  {% endif %}
{% endfor %}
